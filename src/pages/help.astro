---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import { getI18n } from '../lib/i18n';

const user = Astro.locals.user;
const { lang, t } = getI18n(Astro);
---

<Layout title={"FinTrack - " + (lang === 'es' ? 'Ayuda' : 'Help')}>
  <div class="flex flex-col md:flex-row min-h-screen">
    
    <!-- Sidebar / Panel de Control -->
    <div class="hidden md:flex flex-shrink-0">
      <Sidebar active="help" username={user?.username || 'admin'} />
    </div>
    <MobileTabBar active="help" />

    <!-- Main Content Area -->
    <main class="flex-1 p-6 pb-24 md:pb-6 space-y-6 overflow-y-auto">
      
      <!-- Top Title Command -->
      <div class="border-b border-border-subtle pb-4">
        <h1 class="text-xl font-mono text-main font-bold">{t.help_man}</h1>
        <p class="text-xs text-secondary font-mono mt-1">{t.help_subtitle}</p>
      </div>

      <!-- General Info Panel -->
      <div class="border border-border-main p-4 bg-surface-main space-y-2 text-xs font-mono">
        <div class="text-main font-bold">{t.help_system_title}</div>
        <p class="text-secondary leading-relaxed">{t.help_system_desc}</p>
      </div>

      <!-- Modules Documentation Grid -->
      <div class="space-y-6 font-mono">
        
        <!-- Dashboard -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_dashboard_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 1 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_dashboard_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_dashboard_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Transacciones -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_transactions_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 2 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_transactions_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_transactions_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Presupuestos -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_budgets_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 3 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_budgets_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_budgets_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Graficas -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_charts_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 4 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_charts_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_charts_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Objetivos -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_goals_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 5 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_goals_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_goals_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Analisis -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_analysis_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 6 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_analysis_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_analysis_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Respaldos -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_settings_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 7 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_settings_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_settings_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

        <!-- Formulas -->
        <details class="group terminal-window m-0 cursor-pointer">
          <summary class="terminal-header list-none flex justify-between items-center">
            <span>[+] {t.help_formulas_title}</span>
            <div class="flex gap-4">
              <span class="text-muted-text">{t.module} 8 {t.of} 8</span>
              <span class="group-open:hidden">▼</span>
              <span class="hidden group-open:block">▲</span>
            </div>
          </summary>
          <div class="terminal-body text-sm space-y-3 cursor-text">
            <p class="text-secondary leading-relaxed">{t.help_formulas_desc}</p>
            <ul class="list-disc pl-5 space-y-1 text-xs text-secondary">
              {t.help_formulas_items.map(item => (<li>{item}</li>))}
            </ul>
          </div>
        </details>

      </div>
    </main>
  </div>
</Layout>
