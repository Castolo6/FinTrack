---
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/db';
import { formatCLP } from '../lib/utils';

const user = Astro.locals.user;

// Obtener mes actual
const now = new Date();
const currentYear = now.getFullYear();
const currentMonth = String(now.getMonth() + 1).padStart(2, '0');
const startOfMonth = `${currentYear}-${currentMonth}-01`;
const endOfMonth = `${currentYear}-${currentMonth}-31`;

// Obtener presupuestos configurados y calcular el gasto real de cada uno
const budgetsList = db.prepare(`
  SELECT b.id, b.amount as budget_limit, c.name as category_name, c.icon as category_icon, c.id as category_id
  FROM budgets b
  JOIN categories c ON b.category_id = c.id
  WHERE b.start_date = ?
`).all(startOfMonth) as Array<{
  id: string;
  budget_limit: number;
  category_name: string;
  category_icon: string;
  category_id: string;
}>;

// Mapear presupuestos agregando el gasto real del mes actual
const budgets = budgetsList.map(b => {
  const expenseResult = db.prepare(`
    SELECT SUM(amount) as total FROM transactions 
    WHERE category_id = ? AND type = 'expense' AND date >= ? AND date <= ?
  `).get(b.category_id, startOfMonth, endOfMonth) as { total: number | null };
  
  const spent = expenseResult?.total || 0;
  const percent = b.budget_limit > 0 ? Math.min(100, Math.round((spent / b.budget_limit) * 100)) : 0;
  
  // Generar barra de progreso ASCII de terminal
  const bars = Math.min(10, Math.max(0, Math.round(percent / 10)));
  const progress_bar = '[' + '█'.repeat(bars) + '░'.repeat(10 - bars) + ']';

  return {
    ...b,
    spent,
    percent,
    progress_bar
  };
});

// Obtener categorías de gastos para las que aún NO se ha configurado un presupuesto
const categoriesWithoutBudget = db.prepare(`
  SELECT c.id, c.name, c.icon 
  FROM categories c 
  WHERE c.type = 'expense' 
  AND c.id NOT IN (
    SELECT category_id FROM budgets WHERE start_date = ?
  )
  ORDER BY c.name ASC
`).all(startOfMonth) as Array<{
  id: string;
  name: string;
  icon: string;
}>;

// Categorías de gastos para edición
const allExpenseCategories = db.prepare(`
  SELECT id, name, icon FROM categories WHERE type = 'expense' ORDER BY name ASC
`).all() as Array<{
  id: string;
  name: string;
  icon: string;
}>;
---

<Layout title="FinTrack - Presupuestos Mensuales">
  <div class="flex flex-col md:flex-row min-h-screen">
    
    <!-- Sidebar / Panel de Control -->
    <aside class="w-full md:w-64 bg-bg-subtle border-b md:border-b-0 md:border-r border-border-main p-4 flex flex-col md:justify-between gap-4 md:gap-0">
      <div class="flex flex-col md:flex-col justify-between gap-2 md:gap-0">
        <!-- Logo con info de usuario compacta en mobile -->
        <div class="flex items-center justify-between p-2 border border-dashed border-border-subtle bg-bg md:mb-8 w-full">
          <span class="text-lg md:text-xl font-bold text-main font-mono">[FT] FinTrack</span>
          <div class="flex items-center gap-2 md:hidden font-mono text-[10px]">
            <span class="text-secondary">{user?.username || 'admin'}</span>
            <a href="/api/auth/logout" class="text-red-500 border border-red-900 bg-red-950/20 px-2 py-0.5 font-bold">[X]</a>
          </div>
        </div>

        <!-- Navigation Links -->
        <nav class="flex flex-row md:flex-col overflow-x-auto md:overflow-x-visible gap-2 pb-2 md:pb-0 md:space-y-2 text-xs md:text-sm font-mono whitespace-nowrap no-scrollbar">
          <a href="/" class="px-3 py-2 hover:bg-surface-main text-secondary hover:text-main">[DASHBOARD]</a>
          <a href="/transactions" class="px-3 py-2 hover:bg-surface-main text-secondary hover:text-main">[TRANSACCIONES]</a>
          <a href="/budgets" class="px-3 py-2 bg-border-main text-bg font-bold">[PRESUPUESTOS]</a>
          <a href="/charts" class="px-3 py-2 hover:bg-surface-main text-secondary hover:text-main">[GRAFICAS]</a>
          <a href="/goals" class="px-3 py-2 hover:bg-surface-main text-secondary hover:text-main">[OBJETIVOS]</a>
          <a href="/analysis" class="px-3 py-2 hover:bg-surface-main text-secondary hover:text-main">[ANALISIS]</a>
          <a href="/settings" class="px-3 py-2 hover:bg-surface-main text-secondary hover:text-main">[RESPALDOS]</a>
        </nav>
      </div>

      <!-- User/Session info & Logout (solo visible en desktop) -->
      <div class="hidden md:block mt-8 pt-4 border-t border-border-subtle font-mono text-xs text-secondary space-y-2">
        <div>USUARIO: <span class="text-main font-bold">{user?.username || 'admin'}</span></div>
        <a href="/api/auth/logout" class="block mt-4 text-center border border-red-900 bg-red-950/20 hover:bg-red-800 hover:text-bg text-red-500 font-bold py-1 transition-colors">
          [ CERRAR_SESION ]
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-6 space-y-6 overflow-y-auto font-mono">
      
      <!-- Top Title Command -->
      <div class="border-b border-border-subtle pb-4">
        <h1 class="text-xl text-main font-bold">> cat ./budgets.cfg</h1>
        <p class="text-xs text-secondary mt-1">Límites mensuales de gastos y progreso.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left Side: Lista de Presupuestos -->
        <section class="lg:col-span-8 space-y-6">
          <div class="terminal-window m-0">
            <div class="terminal-header">
              <span>fintrack — budgets_status.log — {budgets.length} activos</span>
            </div>
            <div class="terminal-body space-y-6">
              {budgets.length === 0 ? (
                <div class="text-secondary p-2 border border-dashed border-border-subtle bg-bg text-center text-sm">
                  No se han configurado presupuestos mensuales. Utiliza el formulario de la derecha para definir tu primer límite.
                </div>
              ) : (
                <div class="space-y-4">
                  {budgets.map(b => (
                    <div class="border border-border-subtle p-4 bg-bg-subtle text-sm">
                      <div class="flex justify-between font-bold mb-2">
                        <span class="text-main">{b.category_icon} {b.category_name}</span>
                        <span class="text-secondary">
                          {formatCLP(b.spent)} / <span class="text-main">{formatCLP(b.budget_limit)}</span>
                        </span>
                      </div>
                      
                      {/* Barra de progreso */}
                      <div class="flex items-center gap-4 text-xs font-mono">
                        <span class="text-accent">{b.progress_bar}</span>
                        <span class={b.percent >= 100 ? 'text-red-500 font-bold' : b.percent >= 80 ? 'text-yellow-500' : 'text-green-500'}>
                          {b.percent}% {b.percent >= 100 ? '[SOBREPASADO]' : ''}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>

        <!-- Right Side: Configurar Presupuesto -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="terminal-window m-0">
            <div class="terminal-header">
              <span>> write ./configurar_presupuesto.sh</span>
            </div>
            <div class="terminal-body text-xs space-y-3">
              <form id="budget-form" class="space-y-3">
                <div>
                  <label class="block text-secondary mb-1">CATEGORÍA</label>
                  <select id="budget-category" class="w-full bg-surface-main border border-border-main text-main p-2 focus:outline-none focus:border-accent">
                    {allExpenseCategories.map(cat => (
                      <option value={cat.id}>{cat.icon} {cat.name}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label class="block text-secondary mb-1">MÍNIMO LÍMITE (MENSUAL)</label>
                  <input 
                    type="number" 
                    id="budget-amount" 
                    step="0.01" 
                    required 
                    placeholder="0.00" 
                    class="w-full bg-surface-main border border-border-main text-main p-2 focus:outline-none focus:border-accent" 
                  />
                </div>

                <button 
                  type="submit" 
                  class="w-full bg-border-main hover:bg-accent text-bg hover:text-bg font-bold py-2 transition-colors cursor-pointer"
                >
                  [ GUARDAR_PRESUPUESTO ]
                </button>
              </form>
            </div>
          </div>
        </aside>

      </div>

    </main>
  </div>
</Layout>

<script>
  const form = document.getElementById('budget-form');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const category_id = (document.getElementById('budget-category') as HTMLSelectElement).value;
    const amount = parseFloat((document.getElementById('budget-amount') as HTMLInputElement).value);

    try {
      const response = await fetch('/api/budgets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category_id, amount })
      });

      if (!response.ok) {
        const data = await response.json();
        throw new Error(data.error || 'Error al guardar el presupuesto.');
      }

      window.location.reload();
    } catch (err: any) {
      alert(`> ERROR: ${err.message}`);
    }
  });
</script>
