---
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/db';
import Sidebar from '../components/Sidebar.astro';
import { getI18n } from '../lib/i18n';
import { marked } from 'marked';

const user = Astro.locals.user;
const { lang, t } = getI18n(Astro);

// Obtener los análisis guardados en la base de datos
const savedAnalyses = db.prepare('SELECT type, content, updated_at FROM analysis_cache').all() as Array<{
  type: string;
  content: string;
  updated_at: number;
}>;

let defaultTab = 'situacion';
let defaultContent = '';
let defaultTimestamp = 0;

if (savedAnalyses.length > 0) {
  // Sort by updated_at descending to get the most recent
  savedAnalyses.sort((a, b) => b.updated_at - a.updated_at);
  defaultTab = savedAnalyses[0].type;
  defaultContent = savedAnalyses[0].content;
  defaultTimestamp = savedAnalyses[0].updated_at;
}

const formatTimestampServer = (ts: number) => {
  if (!ts) return '';
  const d = new Date(ts);
  const day = String(d.getDate()).padStart(2, '0');
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const hours = String(d.getHours()).padStart(2, '0');
  const minutes = String(d.getMinutes()).padStart(2, '0');
  return `${day}/${month} ${hours}:${minutes}`;
};
const defaultFormattedTime = defaultTimestamp ? formatTimestampServer(defaultTimestamp) : '';
const defaultContentHtml = defaultContent ? marked.parse(defaultContent) : '';
---

<Layout title={"FinTrack - " + (lang === 'es' ? 'Análisis Moneypenny IA' : 'Moneypenny AI Analysis')}>
  <div class="flex flex-col md:flex-row min-h-screen">
    
    <!-- Sidebar / Panel de Control -->
    <Sidebar active="analysis" username={user?.username || 'admin'} />

    <!-- Main Content Area -->
    <main class="flex-1 p-6 space-y-6 overflow-y-auto font-mono">
      
      <!-- Top Title Command -->
      <div class="border-b border-border-subtle pb-4">
        <h1 class="text-xl text-main font-bold">{t.vesper_analyze}</h1>
        <p class="text-xs text-secondary mt-1">{t.analysis_subtitle}</p>
      </div>

      <!-- Vesper System Description Panel -->
      <div class="border border-border-main p-4 bg-surface-main space-y-2 text-xs">
        <div class="text-main font-bold">{t.vesper_info_title}</div>
        <p class="text-secondary leading-relaxed">{t.vesper_info_desc}</p>
      </div>

      <!-- Collapsible Prompts Audit Panel -->
      <details class="border border-border-subtle bg-bg p-3 text-[11px] font-mono cursor-pointer">
        <summary class="text-secondary font-bold hover:text-main select-none">
          {lang === 'es' ? '[+] MOSTRAR PROMPTS DE INSTRUCCIÓN (MONEYPENNY SYSTEM INSTRUCTIONS)' : '[+] SHOW SYSTEM INSTRUCTIONS PROMPTS (MONEYPENNY)'}
        </summary>
        <div class="mt-3 space-y-4 text-[10px] cursor-text border-t border-border-subtle pt-3">
          <div>
            <span class="text-main font-bold">[ PROMPT: {t.tab_situacion} ]</span>
            <pre class="bg-bg-subtle p-2 border border-border-subtle text-muted-text whitespace-pre-wrap mt-1">{
              lang === 'es'
                ? `Eres Moneypenny, asesora financiera personal certificada. Realiza un DIAGNÓSTICO FINANCIERO EJECUTIVO del estado actual del usuario.

METODOLOGÍA DE ANÁLISIS:
1. Salud Patrimonial: Calcula el patrimonio neto total. Evalúa si la distribución de capital entre cuentas es eficiente o si hay capital ocioso.
2. Pulso Presupuestario: Compara el % de presupuesto consumido vs el % del mes transcurrido para cada categoría. Señala zonas de riesgo.
3. Ratio Ingreso/Gasto: Calcula la relación entre ingresos y gastos del mes. Un ratio saludable es >1.3 (ahorrando al menos 30%).
4. Colchón de Emergencia: Evalúa si el usuario tiene liquidez suficiente para cubrir al menos 1 mes de gastos sin ingresos.

FORMATO: Encabezados Markdown (##), cifras concretas en moneda del usuario. Cierra con VEREDICTO: ESTABLE / EN RIESGO / CRÍTICO.`
                : `You are Moneypenny, a certified personal financial advisor. Perform an EXECUTIVE FINANCIAL DIAGNOSIS of the user's current state.

ANALYSIS METHODOLOGY:
1. Net Worth Health: Calculate total net worth. Evaluate if capital distribution across accounts is efficient or if there is idle capital.
2. Budget Pulse: Compare % of budget consumed vs % of month elapsed for each category. Flag risk zones.
3. Income/Expense Ratio: Calculate the relationship between income and expenses. A healthy ratio is >1.3 (saving at least 30%).
4. Emergency Cushion: Evaluate if the user has enough liquidity to cover at least 1 month of expenses without income.

FORMAT: Markdown headings (##), concrete figures in user currency. Close with VERDICT: STABLE / AT RISK / CRITICAL.`
            }</pre>
          </div>
          <div>
            <span class="text-main font-bold">[ PROMPT: {t.tab_fugas} ]</span>
            <pre class="bg-bg-subtle p-2 border border-border-subtle text-muted-text whitespace-pre-wrap mt-1">{
              lang === 'es'
                ? `Eres Moneypenny, auditora financiera forense especializada en detección de fugas de capital. Ejecuta una AUDITORÍA DE FUGAS Y GASTOS FANTASMA.

PROTOCOLO DE AUDITORÍA:
1. Gastos Hormiga: Transacciones pequeñas recurrentes. Calcula acumulado mensual y proyección anual.
2. Suscripciones y Pagos Recurrentes: Detecta duplicidades o servicios infrautilizados.
3. Gastos Impulsivos: Egresos que rompen el patrón normal (montos inusuales, categorías atípicas).
4. Sobregasto por Categoría: Categorías donde el gasto supera o está en camino de superar el presupuesto.

SISTEMA DE ALERTAS:
🔴 CRITICAL — Fuga >10% del ingreso mensual. Acción inmediata.
⚠️ WARNING — Fuga 3%-10% del ingreso. Hábito costoso a corregir.
🟡 CAUTION — Fuga <3% del ingreso, con tendencia creciente.

Cierra con RESUMEN: total fugas, monto fugado, % sobre ingresos.`
                : `You are Moneypenny, a forensic financial auditor specialized in capital leakage detection. Execute a LEAKAGE & PHANTOM EXPENSE AUDIT.

AUDIT PROTOCOL:
1. Micro-expenses: Small recurring transactions. Calculate monthly total and annual projection.
2. Subscriptions & Recurring Payments: Detect duplicates or underutilized services.
3. Impulse Spending: Outlier expenses that break normal spending patterns.
4. Category Overspend: Categories where spending exceeds or is on track to exceed budget.

ALERT SYSTEM:
🔴 CRITICAL — Leakage >10% of monthly income. Immediate action required.
⚠️ WARNING — Leakage 3%-10% of income. Costly habit to correct.
🟡 CAUTION — Leakage <3% of income, with growing trend.

Close with SUMMARY: total leakages, leaked amount, % of income.`
            }</pre>
          </div>
          <div>
            <span class="text-main font-bold">[ PROMPT: {t.tab_mejoras} ]</span>
            <pre class="bg-bg-subtle p-2 border border-border-subtle text-muted-text whitespace-pre-wrap mt-1">{
              lang === 'es'
                ? `Eres Moneypenny, consultora financiera estratégica. Diseña un PLAN TÁCTICO DE OPTIMIZACIÓN FINANCIERA personalizado.

ESTRUCTURA DEL PLAN:
1. Recortes Inmediatos (esta semana): 2-3 acciones ejecutables HOY. Indica categoría, ahorro estimado, y alternativa concreta.
2. Optimización de Flujo (este mes): 2-3 estrategias de redistribución de capital entre cuentas.
3. Hábitos Frugales de Alto Impacto (largo plazo): 2-3 cambios de hábito con proyección de ahorro anual.
4. Meta de Ahorro Sugerida: Porcentaje realista y monto exacto basado en ingresos/gastos actuales.

Cada medida incluye: acción concreta, ahorro estimado, dificultad (FÁCIL / MEDIA / DIFÍCIL). Sin consejos genéricos.`
                : `You are Moneypenny, a strategic financial consultant. Design a personalized TACTICAL FINANCIAL OPTIMIZATION PLAN.

PLAN STRUCTURE:
1. Immediate Cuts (this week): 2-3 actions executable TODAY. Specify category, estimated savings, and concrete alternative.
2. Flow Optimization (this month): 2-3 capital redistribution strategies across accounts.
3. High-Impact Frugal Habits (long term): 2-3 habit changes with annual savings projection.
4. Suggested Savings Target: Realistic percentage and exact amount based on current income/expenses.

Each measure includes: concrete action, estimated savings, difficulty (EASY / MEDIUM / HARD). No generic advice.`
            }</pre>
          </div>
          <div>
            <span class="text-main font-bold">[ PROMPT: {t.tab_objetivos} ]</span>
            <pre class="bg-bg-subtle p-2 border border-border-subtle text-muted-text whitespace-pre-wrap mt-1">{
              lang === 'es'
                ? `Eres Moneypenny, analista financiera cuantitativa. Realiza un ANÁLISIS MATEMÁTICO DE VIABILIDAD de los objetivos de ahorro.

METODOLOGÍA POR OBJETIVO:
1. Progreso Actual: % completado (acumulado / meta).
2. Tiempo Restante: Meses exactos entre hoy y el deadline.
3. Aporte Mensual Requerido: (meta - acumulado) / meses restantes.
4. Probabilidad de Cumplimiento: 0-100% basado en aporte requerido vs ingreso disponible.
   - <15% ingreso → ALTA (70-100%) | 15-30% → MEDIA (40-69%) | >30% → BAJA (0-39%)
5. Clasificación: ✅ FACTIBLE | ⚠️ EN RIESGO | 🔴 INVIABLE

Cierra con RECOMENDACIÓN ESTRATÉGICA: orden de prioridad y si conviene pausar algún objetivo.`
                : `You are Moneypenny, a quantitative financial analyst. Perform a MATHEMATICAL VIABILITY ANALYSIS of savings goals.

METHODOLOGY PER GOAL:
1. Current Progress: % completed (accumulated / target).
2. Remaining Time: Exact months between today and the deadline.
3. Required Monthly Contribution: (target - accumulated) / months remaining.
4. Completion Probability: 0-100% based on required contribution vs available income.
   - <15% income → HIGH (70-100%) | 15-30% → MEDIUM (40-69%) | >30% → LOW (0-39%)
5. Classification: ✅ FEASIBLE | ⚠️ AT RISK | 🔴 NOT VIABLE

Close with STRATEGIC RECOMMENDATION: priority order and whether to pause any goal to concentrate resources.`
            }</pre>
          </div>
        </div>
      </details>

      <!-- Actions & Terminal Output Window -->
      <div class="flex flex-col h-[700px] border border-border-main bg-surface-main">
        
        <!-- Terminal Output Window (Chat History) -->
        <div class="terminal-window m-0 flex-1 flex flex-col min-h-0 border-0 border-b border-border-main">
          <div class="terminal-header">
            <span>moneypenny@fintrack — chat — bash 80x24</span>
          </div>
          <div class="terminal-body bg-bg text-main font-mono text-xs md:text-sm flex-1 overflow-y-auto p-4" id="terminal-stdout-container">
            <div id="chat-history" class="space-y-6">
              <div class="markdown-body max-w-none text-accent border border-accent/20 bg-accent/5 p-3">
                <strong>> MONEYPENNY OS v2.0</strong><br/>
                {lang === 'es' 
                  ? '> Conexión establecida. ¿En qué te puedo asesorar hoy? Elige una auditoría rápida o hazme una pregunta directa.'
                  : '> Connection established. How can I advise you today? Choose a quick audit or ask me a direct question.'}
              </div>
            </div>
            <div id="loading-indicator" class="hidden mt-6 text-accent animate-pulse font-bold"></div>
          </div>
        </div>

        <!-- Chat Input & Quick Actions Area -->
        <div class="p-3 bg-surface-main shrink-0">
          <!-- Quick Actions (chips) -->
          <div class="flex flex-wrap gap-2 mb-3">
            <button data-type="situacion" class="analysis-trigger text-[10px] uppercase border border-border-main px-2 py-1 bg-bg-subtle text-main hover:bg-border-main hover:text-bg transition-colors cursor-pointer">
              {lang === 'es' ? '[ AUDITAR SITUACIÓN ]' : '[ AUDIT SITUATION ]'}
            </button>
            <button data-type="fugas" class="analysis-trigger text-[10px] uppercase border border-border-main px-2 py-1 bg-bg-subtle text-main hover:bg-border-main hover:text-bg transition-colors cursor-pointer">
              {lang === 'es' ? '[ DETECTAR FUGAS ]' : '[ DETECT LEAKAGES ]'}
            </button>
            <button data-type="mejoras" class="analysis-trigger text-[10px] uppercase border border-border-main px-2 py-1 bg-bg-subtle text-main hover:bg-border-main hover:text-bg transition-colors cursor-pointer">
              {lang === 'es' ? '[ PLAN DE MEJORAS ]' : '[ IMPROVEMENT PLAN ]'}
            </button>
            <button data-type="objetivos" class="analysis-trigger text-[10px] uppercase border border-border-main px-2 py-1 bg-bg-subtle text-main hover:bg-border-main hover:text-bg transition-colors cursor-pointer">
              {lang === 'es' ? '[ VIABILIDAD OBJETIVOS ]' : '[ GOALS VIABILITY ]'}
            </button>
          </div>

          <!-- Input Form -->
          <form id="chat-form" class="flex items-center gap-2">
            <span class="text-accent font-bold">$></span>
            <input 
              type="text" 
              id="chat-input" 
              placeholder={lang === 'es' ? 'Hazle una pregunta abierta a Moneypenny...' : 'Ask Moneypenny an open question...'}
              class="flex-1 bg-transparent border-none outline-none text-main text-xs md:text-sm font-mono placeholder-muted-text"
              autocomplete="off"
              required
            />
            <button 
              type="submit" 
              id="chat-submit"
              class="bg-accent text-bg hover:bg-accent/80 font-bold px-4 py-1 transition-colors text-xs uppercase cursor-pointer"
            >
              {lang === 'es' ? 'ENVIAR' : 'SEND'}
            </button>
          </form>
        </div>
      </div>
    </main>
  </div>
</Layout>

<div id="analysis-data" data-analyses={JSON.stringify(savedAnalyses)} class="hidden"></div>

<script>
  import { marked } from 'marked';

  document.addEventListener('astro:page-load', () => {
    const triggerButtons = document.querySelectorAll('.analysis-trigger');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const chatSubmit = document.getElementById('chat-submit') as HTMLButtonElement;
    const chatHistory = document.getElementById('chat-history');
    const loadingIndicator = document.getElementById('loading-indicator');
    const terminalStdoutContainer = document.getElementById('terminal-stdout-container');

    let isProcessing = false;

    function formatTokens(text) {
      if (!text) return '';
      return text
        .replace(/\[VERDE:\s*([^\]]+)\]/gi, '<span class="text-green-500 font-bold">🟢 $1</span>')
        .replace(/\[AMARILLO:\s*([^\]]+)\]/gi, '<span class="text-yellow-500 font-bold">🟡 $1</span>')
        .replace(/\[ROJO:\s*([^\]]+)\]/gi, '<span class="text-red-500 font-bold">🔴 $1</span>');
    }

    function scrollToBottom() {
      if (terminalStdoutContainer) {
        setTimeout(() => {
          terminalStdoutContainer.scrollTop = terminalStdoutContainer.scrollHeight;
        }, 50);
      }
    }

    function appendMessage(role, text) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'mt-6 border-t border-border-subtle pt-4';
      if (role === 'user') {
        msgDiv.innerHTML = `<div class="text-accent font-bold">> [ USUARIO ]</div><div class="mt-1">${text}</div>`;
      } else if (role === 'system') {
        msgDiv.innerHTML = `<div class="text-main font-bold">> [ MONEYPENNY ]</div><div class="mt-2 markdown-body max-w-none text-sm">${marked.parse(formatTokens(text))}</div>`;
      } else if (role === 'error') {
        msgDiv.innerHTML = `<div class="text-red-500 font-bold">> [ FALLO CRÍTICO ]</div><div class="mt-1 text-red-500">${text}</div>`;
      }
      chatHistory?.appendChild(msgDiv);
      scrollToBottom();
    }

    function showLoading() {
      loadingIndicator?.classList.remove('hidden');
      if (loadingIndicator) loadingIndicator.innerHTML = '> Procesando análisis neuronal...';
      scrollToBottom();
    }

    function hideLoading() {
      loadingIndicator?.classList.add('hidden');
    }

    async function handleRequest(endpoint, bodyParams, userPromptDisplay) {
      if (isProcessing) return;
      isProcessing = true;
      if (chatInput) chatInput.disabled = true;
      if (chatSubmit) {
        chatSubmit.disabled = true;
        chatSubmit.classList.add('opacity-50', 'cursor-not-allowed');
      }

      triggerButtons.forEach(btn => {
        (btn as HTMLButtonElement).disabled = true;
        btn.classList.add('opacity-40', 'cursor-not-allowed');
      });

      appendMessage('user', userPromptDisplay);
      showLoading();

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(bodyParams)
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Error desconocido del agente.');
        }

        const replyContent = data.analysis || data.reply;
        appendMessage('system', replyContent);

      } catch (err: any) {
        appendMessage('error', err.message);
      } finally {
        hideLoading();
        isProcessing = false;
        if (chatInput) chatInput.disabled = false;
        if (chatSubmit) {
          chatSubmit.disabled = false;
          chatSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        
        triggerButtons.forEach(btn => {
          (btn as HTMLButtonElement).disabled = false;
          btn.classList.remove('opacity-40', 'cursor-not-allowed');
        });
        if (chatInput) chatInput.focus();
      }
    }

    // Bind chips
    triggerButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type');
        let label = btn.textContent?.trim().replace(/\[/g, '').replace(/\]/g, '').trim() || type;
        handleRequest('/api/analysis', { type }, `Ejecutando auditoría: ${label}`);
      });
    });

    // Bind chat form
    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!chatInput) return;
      const message = chatInput.value.trim();
      if (!message) return;
      
      chatInput.value = '';
      handleRequest('/api/chat', { message }, message);
    });

  });
</script>
