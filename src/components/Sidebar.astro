---
import { getI18n } from '../lib/i18n';

interface Props {
  active: 'dashboard' | 'history' | 'portfolio' | 'budgets' | 'analysis' | 'settings' | 'help';
  username?: string;
}

const { active, username = 'admin' } = Astro.props;
const { lang, t } = getI18n(Astro);

const getLinkClass = (page: string) => {
  return active === page
    ? 'px-3 py-2 bg-border-main text-bg font-bold'
    : 'px-3 py-2 hover:bg-surface-main text-secondary hover:text-main';
};
---

<aside class="w-full md:w-64 bg-bg-subtle border-b md:border-b-0 md:border-r border-border-main p-4 flex flex-col md:justify-between gap-4 md:gap-0">
  <div class="flex flex-col md:flex-col justify-between gap-2 md:gap-0">
    <!-- Logo con info de usuario compacta en mobile -->
    <div class="flex items-center justify-between p-2 border border-dashed border-border-subtle bg-bg md:mb-8 w-full">
      <span class="text-lg md:text-xl font-bold text-main font-mono">[FT] FinTrack</span>
      <div class="flex items-center gap-2 md:hidden font-mono text-[10px]">
        <span class="text-secondary">{username}</span>
        <a href="/api/auth/logout" class="text-red-500 border border-red-900 bg-red-950/20 px-2 py-0.5 font-bold">[X]</a>
      </div>
    </div>

    <!-- Navigation Links -->
    <nav class="flex flex-row md:flex-col overflow-x-auto md:overflow-x-visible gap-2 pb-2 md:pb-0 md:space-y-2 text-xs md:text-sm font-mono whitespace-nowrap no-scrollbar">
      <a href="/" class={getLinkClass('dashboard')}>{t.dashboard}</a>
      <a href="/history" class={getLinkClass('history')}>{t.history}</a>
      <a href="/portfolio" class={getLinkClass('portfolio')}>{t.portfolio}</a>
      <a href="/budgets" class={getLinkClass('budgets')}>{t.budgets}</a>
      <a href="/analysis" class={getLinkClass('analysis')}>{t.analysis}</a>
      <a href="/settings" class={getLinkClass('settings')}>{t.settings}</a>
      <a href="/help" class={getLinkClass('help')}>{t.help}</a>
    </nav>
  </div>

  <!-- User/Session info & Logout (solo visible en desktop) -->
  <div class="hidden md:block mt-8 pt-4 border-t border-border-subtle font-mono text-xs text-secondary space-y-2">
    <div>{t.user}: <span class="text-main font-bold">{username}</span></div>
    <div>{t.client_ip}: <span id="client-ip-sidebar" class="text-muted-text">{t.local_network}</span></div>
    
    <!-- Idioma Selector -->
    <div class="flex justify-between items-center pt-2 border-t border-dashed border-border-subtle">
      <span>{t.lang_label}</span>
      <div class="flex gap-1.5">
        <button
          id="btn-lang-es"
          class={`px-1.5 py-0.5 border text-[10px] font-bold cursor-pointer transition-colors ${lang === 'es' ? 'bg-border-main text-bg border-border-main' : 'bg-surface-main text-secondary border-border-subtle hover:text-main hover:border-border-main'}`}
        >
          ES
        </button>
        <button
          id="btn-lang-en"
          class={`px-1.5 py-0.5 border text-[10px] font-bold cursor-pointer transition-colors ${lang === 'en' ? 'bg-border-main text-bg border-border-main' : 'bg-surface-main text-secondary border-border-subtle hover:text-main hover:border-border-main'}`}
        >
          EN
        </button>
      </div>
    </div>

    <a href="/api/auth/logout" class="block mt-4 text-center border border-red-900 bg-red-950/20 hover:bg-red-800 hover:text-bg text-red-500 font-bold py-1 transition-colors">
      {t.logout}
    </a>
  </div>
</aside>

<script>
  document.addEventListener('astro:page-load', () => {
// Intentar obtener la IP local ficticia/real en el sidebar
  const clientIpEl = document.getElementById('client-ip-sidebar');
  if (clientIpEl) {
    clientIpEl.textContent = window.location.hostname;
  }

  // Configurar los botones de idioma
  const btnEs = document.getElementById('btn-lang-es');
  const btnEn = document.getElementById('btn-lang-en');
  if (btnEs) {
    btnEs.addEventListener('click', () => {
      document.cookie = "lang=es; path=/; max-age=31536000";
      window.location.reload();
    });
  }
  if (btnEn) {
    btnEn.addEventListener('click', () => {
      document.cookie = "lang=en; path=/; max-age=31536000";
      window.location.reload();
    });
  }
  });
</script>
