---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'FinTrack - Hacker Terminal Finance', description = 'Administrador de finanzas personales local-first.' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<ClientRouter />
	</head>
	<body>
		<div id="global-loader" class="fixed top-0 left-0 w-full h-[2px] bg-transparent z-[100] overflow-hidden pointer-events-none">
			<div id="global-loader-bar" class="h-full bg-accent w-0"></div>
		</div>

		<!-- Modal de Confirmación Global -->
		<div id="fintrack-confirm-modal" class="fixed inset-0 bg-bg/80 backdrop-blur-sm z-[200] hidden items-center justify-center p-4">
			<div class="terminal-window m-0 max-w-md w-full border-red-500 shadow-[0_0_15px_rgba(239,68,68,0.2)]">
				<div class="terminal-header border-red-500/50 text-red-500">
					<span>[!] REQUIRES_CONFIRMATION</span>
				</div>
				<div class="terminal-body font-mono text-sm space-y-4">
					<p id="fintrack-confirm-message" class="text-main">¿Estás seguro?</p>
					<div class="flex justify-end gap-3 mt-6 pt-4 border-t border-border-subtle">
						<button id="fintrack-confirm-cancel" class="px-4 py-2 bg-surface-main hover:bg-border-subtle border border-border-main text-secondary hover:text-main font-bold transition-colors cursor-pointer">
							[ CANCELAR ]
						</button>
						<button id="fintrack-confirm-ok" class="px-4 py-2 bg-red-950/30 hover:bg-red-500 border border-red-900 hover:border-red-500 text-red-500 hover:text-bg font-bold transition-colors cursor-pointer">
							[ CONFIRMAR ]
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Modal de Alerta Global -->
		<div id="fintrack-alert-modal" class="fixed inset-0 bg-bg/80 backdrop-blur-sm z-[200] hidden items-center justify-center p-4">
			<div class="terminal-window m-0 max-w-md w-full border-accent shadow-[0_0_15px_rgba(29,199,181,0.2)]">
				<div class="terminal-header border-accent/50 text-accent">
					<span>[i] SYSTEM_MESSAGE</span>
				</div>
				<div class="terminal-body font-mono text-sm space-y-4">
					<p id="fintrack-alert-message" class="text-main"></p>
					<div class="flex justify-end gap-3 mt-6 pt-4 border-t border-border-subtle">
						<button id="fintrack-alert-ok" class="px-4 py-2 bg-surface-main hover:bg-border-subtle border border-border-main text-secondary hover:text-main font-bold transition-colors cursor-pointer">
							[ ENTENDIDO ]
						</button>
					</div>
				</div>
			</div>
		</div>

		<slot />

		<script is:inline>
			if (!window.loaderInitialized) {
				document.addEventListener('astro:before-preparation', () => {
					const loader = document.getElementById('global-loader-bar');
					if (loader) {
						loader.style.transition = 'width 10s cubic-bezier(0.1, 0.8, 1.0, 0.1)';
						loader.style.width = '85%';
					}
				});
				document.addEventListener('astro:after-preparation', () => {
					const loader = document.getElementById('global-loader-bar');
					if (loader) {
						loader.style.transition = 'width 0.2s ease-out';
						loader.style.width = '100%';
						setTimeout(() => {
							loader.style.transition = 'none';
							loader.style.width = '0';
						}, 300);
					}
				});
				window.loaderInitialized = true;
			}

			// Utilidad global de alerta
			window.FinTrackAlert = function(message) {
				return new Promise((resolve) => {
					const modal = document.getElementById('fintrack-alert-modal');
					const msgEl = document.getElementById('fintrack-alert-message');
					const btnOk = document.getElementById('fintrack-alert-ok');
					
					if(!modal || !msgEl || !btnOk) {
						alert(message);
						resolve();
						return;
					}
					
					msgEl.textContent = message;
					modal.classList.remove('hidden');
					modal.classList.add('flex');
					
					const cleanup = () => {
						modal.classList.add('hidden');
						modal.classList.remove('flex');
						btnOk.removeEventListener('click', onOk);
					};
					
					const onOk = () => { cleanup(); resolve(); };
					
					btnOk.addEventListener('click', onOk);
				});
			};

			// Utilidad global de confirmación
			window.FinTrackConfirm = function(message) {
				return new Promise((resolve) => {
					const modal = document.getElementById('fintrack-confirm-modal');
					const msgEl = document.getElementById('fintrack-confirm-message');
					const btnOk = document.getElementById('fintrack-confirm-ok');
					const btnCancel = document.getElementById('fintrack-confirm-cancel');
					
					if(!modal || !msgEl || !btnOk || !btnCancel) {
						resolve(confirm(message));
						return;
					}
					
					msgEl.textContent = message;
					modal.classList.remove('hidden');
					modal.classList.add('flex');
					
					const cleanup = () => {
						modal.classList.add('hidden');
						modal.classList.remove('flex');
						btnOk.removeEventListener('click', onOk);
						btnCancel.removeEventListener('click', onCancel);
					};
					
					const onOk = () => { cleanup(); resolve(true); };
					const onCancel = () => { cleanup(); resolve(false); };
					
					btnOk.addEventListener('click', onOk);
					btnCancel.addEventListener('click', onCancel);
				});
			};
		</script>
	</body>
</html>
